# Copia este archivo como ".env" y completa tu clave. El archivo .env NUNCA se sube a GitHub.

# Clave gratuita de Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Modelo con soporte de tool calling. Lista vigente: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Opcional: otro endpoint compatible con OpenAI (NVIDIA NIM, Ollama, ...)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Opcional: token de datos.gov.co para evitar límites al descargar (https://www.datos.gov.co/profile/edit/developer_settings)
# SOCRATA_APP_TOKEN=
